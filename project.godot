; Engine configuration file.
; Expedition: Brave Unknown - guild + auto-battle prototype

config_version=5

[application]

config/name="Expedition: Brave Unknown (Prototype)"
config/description="Guild recruitment, party formation and auto-battle test bed."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.086, 0.094, 0.114, 1)
